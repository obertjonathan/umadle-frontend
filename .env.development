# Base URL of umadle-backend (includes the /umadle context path)
UMADLE_BACKEND_API_BASE_URL=http://localhost:8080/umadle

# Testing only: random uma each round, no saved progress, "Play again" button.
# Set to false (or remove) to get the normal one-puzzle-per-day game back.
UMADLE_PRACTICE_MODE=true
